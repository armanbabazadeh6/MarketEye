{
  "name": "marketeye",
  "private": true,
  "version": "0.1.0",
  "description": "Evidence-backed geospatial company exposure intelligence built on Cesium and Gods Eye View.",
  "type": "module",
  "license": "MIT",
  "author": "Arman Babazadeh",
  "homepage": "https://github.com/armanbabazadeh6/MarketEye#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/armanbabazadeh6/MarketEye.git"
  },
  "bugs": {
    "url": "https://github.com/armanbabazadeh6/MarketEye/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs",
    "test:marketeye": "node --test src/exposure/engine.test.mjs src/events/normalize.test.mjs src/providers/worldEvents.test.mjs src/analyst/analyst.test.mjs src/analyst/proxy.test.mjs",
    "qa:marketeye": "node scripts/qa-marketeye.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  }
}
